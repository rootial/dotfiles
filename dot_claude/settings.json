{
  "env": {},
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mingliang/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"--- $(date '+%H:%M:%S') ---\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "acpx@frad-dotclaude": true,
    "superpowers@claude-plugins-official": true,
    "git@frad-dotclaude": true,
    "recall@FlineDev": true,
    "telegram@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "frad-dotclaude": {
      "source": {
        "source": "github",
        "repo": "FradSer/dotclaude"
      }
    },
    "FlineDev": {
      "source": {
        "source": "git",
        "url": "https://github.com/FlineDev/Marketplace.git"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "model": "opusplan",
  "autoMemoryEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  }
}
